<section class="prices" data-reveal>
	<div class="wrap">
		<p class="lede">{{data.prices.intro}}</p>
		<h2>{{data.prices.bataTitle}}</h2>
		<div class="table-wrap" tabindex="0">
			<table>
				<caption class="sr-only">{{data.prices.bataTitle}}, цене у динарима</caption>
				<thead>
					<tr>
						{{#each data.prices.bataHeads}}<th scope="col">{{this}}</th>{{/each}}
					</tr>
				</thead>
				<tbody>
					{{#each data.prices.bata}}
						<tr>
							<th scope="row">{{lookup this 0}}</th>
							<td>{{lookup this 1}}</td>
							<td>{{lookup this 2}}</td>
							<td>{{lookup this 3}}</td>
						</tr>
					{{/each}}
				</tbody>
			</table>
		</div>
		<h2>{{data.prices.novaTitle}}</h2>
		<div class="table-wrap" tabindex="0">
			<table>
				<caption class="sr-only">{{data.prices.novaTitle}}, цене у динарима</caption>
				<thead>
					<tr>
						{{#each data.prices.novaHeads}}<th scope="col">{{this}}</th>{{/each}}
					</tr>
				</thead>
				<tbody>
					{{#each data.prices.nova}}
						<tr>
							<th scope="row">{{lookup this 0}}</th>
							<td>{{lookup this 1}}</td>
							<td>{{lookup this 2}}</td>
						</tr>
					{{/each}}
				</tbody>
			</table>
		</div>
		<h2>Попусти</h2>
		<ul class="prices__rules">
			{{#each data.prices.rules}}<li>{{this}}</li>{{/each}}
		</ul>
		<p>
			{{#each data.prices.links}}
				<a class="text-link" href="{{{href}}}" target="_blank" rel="noopener noreferrer">{{label}}</a>
			{{/each}}
		</p>
	</div>
</section>
