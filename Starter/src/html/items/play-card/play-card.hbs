<article class="play-card">
	<p class="play-card__scene">{{scene}}</p>
	<h3 class="play-card__title"><a href="{{{url}}}" target="_blank" rel="noopener noreferrer">{{title}}</a></h3>
	{{#if quote}}<blockquote class="play-card__quote">{{quote}}</blockquote>{{/if}}
	{{#if note}}<p class="play-card__note">{{note}}</p>{{/if}}
	{{#if cast}}<p class="play-card__cast">{{cast}}</p>{{/if}}
	<a class="text-link" href="{{{url}}}" target="_blank" rel="noopener noreferrer">Страница представе</a>
</article>
